# ----- Auth0 (https://manage.auth0.com — Application "Regular Web Application") -----
# Domaine du tenant, sans https:// (ex : centremedical.eu.auth0.com)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Clé de chiffrement du cookie de session : générer avec `openssl rand -hex 32`
AUTH0_SECRET=
# URL publique de l'application, telle que tapée dans le navigateur.
# Derrière un reverse proxy : https://rh.moncentre.fr
# En accès direct sur un autre port : http://mon-serveur:8080 (doit inclure APP_PORT)
APP_BASE_URL=http://localhost:3000

# ----- Base de données PostgreSQL -----
# En dev local. En Docker Compose, DATABASE_URL est construit automatiquement vers le service `db`.
DATABASE_URL=postgresql://centremedical:changez-moi@localhost:5432/centremedical
POSTGRES_USER=centremedical
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=centremedical

# ----- Application -----
CENTER_NAME="Centre Médical"
# Port ÉCOUTÉ SUR LA MACHINE HÔTE par docker compose.
# Changez-le si le 3000 est déjà pris sur votre serveur (ex : APP_PORT=8080).
# Le port interne du conteneur reste 3000 : rien d'autre n'est à modifier,
# à part APP_BASE_URL ci-dessus si vous accédez à l'application sans reverse proxy.
APP_PORT=3000
# Dossier de stockage des fichiers (devis, documents employés)
UPLOAD_DIR=./uploads
